#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
project_dir="$(cd -- "$script_dir/.." && pwd)"
wifi_interface="${NMRPEAK_WIFI_INTERFACE:-wlp10s0}"
proxy_state_dir="$(mktemp -d)"
ready_file="$proxy_state_dir/port"
proxy_pid=""

cleanup() {
  if [[ -n "$proxy_pid" ]]; then
    kill "$proxy_pid" 2>/dev/null || true
    wait "$proxy_pid" 2>/dev/null || true
  fi
  rm -r -- "$proxy_state_dir"
}
trap cleanup EXIT INT TERM

[[ -d "/sys/class/net/$wifi_interface" ]] || {
  printf 'ERROR: Wi-Fi interface does not exist: %s\n' "$wifi_interface" >&2
  exit 1
}

python "$project_dir/docker/bound_http_proxy.py" \
  --interface "$wifi_interface" \
  --ready-file "$ready_file" &
proxy_pid=$!

for _ in {1..100}; do
  [[ -s "$ready_file" ]] && break
  kill -0 "$proxy_pid" 2>/dev/null || {
    wait "$proxy_pid"
    exit 1
  }
  sleep 0.05
done
[[ -s "$ready_file" ]] || {
  printf 'ERROR: Wi-Fi-bound proxy did not become ready\n' >&2
  exit 1
}

proxy_port="$(<"$ready_file")"
printf 'Building through %s using loopback proxy port %s\n' \
  "$wifi_interface" "$proxy_port"

cd -- "$project_dir"
NMRPEAK_BUILD_NETWORK=host \
NMRPEAK_BUILD_HTTP_PROXY="http://127.0.0.1:$proxy_port" \
  docker compose build "$@"
