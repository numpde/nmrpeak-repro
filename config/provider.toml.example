# Provider API inputs and host-owned shared socket settings.
schema_id = "nmrpeak.provider.runtime_config.v3"

[api]
origin = "https://api.example.invalid"
profile = "run"
topology = "web"
provider_ref = "provider:example"
credential_file = "/absolute/path/to/provider-credential.json"
ca_file = "/absolute/path/to/api-ca.pem"
exchange_seconds = 30
retirement_seconds = 10

[shared]
settings_file = "/absolute/path/to/shared-settings.toml"

[process]
feed_interval_seconds = 5
hello_interval_seconds = 3600
shutdown_drain_seconds = 330
forced_join_seconds = 10
inventory_maximum_pages = 20
observation_interval_seconds = 1
observation_retry_initial_seconds = 5
observation_retry_max_seconds = 30

[runner]
# Private control connection and greeting; scientific READY has the next budget.
connect_seconds = 30
ready_seconds = 600
validate_seconds = 30
generate_seconds = 600
# Native TERM + KILL + scratch cleanup + observation; generation has its own budget.
retire_seconds = 20

[interpreter]
request_timeout_seconds = 25
turn_timeout_seconds = 60
interpretation_timeout_seconds = 240
